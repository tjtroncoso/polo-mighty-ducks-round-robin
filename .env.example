# Server only. Connect Neon through Vercel Storage to inject this automatically.
# Never use a VITE_ prefix for this secret.
DATABASE_URL=

# Preview-only connection for the paid-beta branch. Configure this only for
# Vercel Preview and scope it to the paid-beta Git branch.
PAID_BETA_DATABASE_URL=

# Vercel's Neon integration creates this name when the resource connection uses
# PAID_BETA_DATABASE_URL as its environment-variable prefix.
PAID_BETA_DATABASE_URL_DATABASE_URL=
